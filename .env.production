# FutureVest Production Environment Configuration

# Database Configuration
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=futurevest_prod
MYSQL_USER=futurevest_user
MYSQL_PASSWORD=your_secure_db_password_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
DDL_AUTO=validate
SHOW_SQL=false
FORMAT_SQL=false

# AWS Configuration
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=futurevest-prod-uploads

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_SECRET=your_razorpay_secret_here

# JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_here_minimum_256_bits
JWT_EXPIRATION=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://futurevest.com,https://www.futurevest.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password_here

# Logging Configuration
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_FUTUREVEST=INFO

# Frontend Configuration
REACT_APP_API_BASE_URL=https://api.futurevest.com/api/v1
REACT_APP_WS_BASE_URL=wss://api.futurevest.com/ws
REACT_APP_RAZORPAY_KEY_ID=your_razorpay_key_id_here
REACT_APP_ENVIRONMENT=production
REACT_APP_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID_HERE
REACT_APP_SENTRY_DSN=your_sentry_dsn_here
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
REACT_APP_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# SSL Configuration (for HTTPS)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Backup Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Security Configuration
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Performance Configuration
CACHE_TTL=3600
CONNECTION_POOL_SIZE=20
MAX_CONNECTIONS=200
